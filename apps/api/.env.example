NODE_ENV=development
HOST=127.0.0.1
PORT=4000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://ticketz:ticketz123@127.0.0.1:5432/ticketz?schema=public
DATABASE_DIRECT_URL=postgresql://ticketz:ticketz123@127.0.0.1:5432/ticketz?schema=public
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-random-local-value
POLL_METADATA_ENCRYPTION_KEY=replace-with-different-random-local-value
USE_REAL_DATA=false

# In development without integrations, boot uses a loopback placeholder.
# Set LEAD_ENGINE_BROKER_BASE_URL and LEAD_ENGINE_BASIC_TOKEN to enable USE_REAL_DATA.
# WHATSAPP_BROKER_URL=
# WHATSAPP_BROKER_API_KEY=
# WHATSAPP_WEBHOOK_API_KEY=
# WHATSAPP_WEBHOOK_HMAC_SECRET=
# WHATSAPP_WEBHOOK_ENFORCE_SIGNATURE=true
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Max size (bytes) of inbound media downloaded straight from the WhatsApp CDN (default 64 MiB);
# larger files fall back to the broker download. See src/lib/whatsapp-crypto/README.md.
# WHATSAPP_MEDIA_MAX_BYTES=67108864
